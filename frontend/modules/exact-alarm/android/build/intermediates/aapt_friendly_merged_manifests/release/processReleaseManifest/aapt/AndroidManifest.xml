<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.ischys.exactalarm" >

    <uses-sdk android:minSdkVersion="24" />
    <!--
         Lets the end-of-rest alert fire on the second. Without it Android may
         deliver a scheduled notification anywhere in a window as long as most
         of the rest itself. Granted by default up to Android 13; from 14 the
         user turns it on under "Alarms & reminders".
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

</manifest>