<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Heart rate from the running session. BODY_SENSORS up to Wear OS 5.1;
         the granular health permission replaces it from Wear OS 6. -->
    <uses-permission android:name="android.permission.BODY_SENSORS" android:maxSdkVersion="35" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <!-- Calories from the running session. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- The session records with the wrist down, so it runs in a foreground
         service, whose notification is also the watch-face indicator. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The end-of-rest buzz, and staying awake for the seconds until it. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <queries>
        <package android:name="com.google.android.wearable.healthservices" />
    </queries>

    <application
        android:name=".IschysWearApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Not standalone: the phone app holds the workout. Without the phone
             app the Watch can only run an empty session. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.Ischys">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".session.ExerciseService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <!-- Bound by Google Play services when the phone sends something, which
             is what lets a push or a command arrive with this app not running. -->
        <service
            android:name=".link.WearLinkService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/ischys/" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/ischys/state" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/ischys/command" />
            </intent-filter>
        </service>
    </application>
</manifest>
